---
import Layout from "@/layouts/Layout.astro";
import Breadcrumb from "@/components/post/Breadcrumb.astro";
import PostHeader from "@/components/post/PostHeader.astro";
import PostFooter from "@/components/post/PostFooter.astro";
import HyacineOutlet from "@hyacine/plugin-astro/components/HyacineOutlet.astro";
import { currentLocale } from "@/i18n";
import AdmirationContent, { frontmatter as admirationFrontmatter } from "@/content/admiration.mdx";
import themeConfig from "@/theme.config";

import "@/styles/post.css";
import "@/styles/spoiler.css";
import "katex/dist/katex-swap.min.css";

// 由原 ShokaX Hexo 的 source/_posts/admiration.md 迁移而来的独立页面。
// 结构与 about 页面保持一致，仅内容源不同。
interface AdmirationFrontmatter {
  title?: string;
  description?: string;
  date?: string | Date;
  updated?: string | Date;
}

const frontmatter = (admirationFrontmatter ?? {}) as AdmirationFrontmatter;

const parseDate = (value: string | Date | undefined, fallback: Date) => {
  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    return value;
  }
  if (typeof value === "string") {
    const parsed = new Date(value);
    if (!Number.isNaN(parsed.getTime())) {
      return parsed;
    }
  }
  return fallback;
};

const fallbackDate = new Date();
const title = frontmatter.title || "赞助博主";
const description = frontmatter.description || "赞助博主";
const publishDate = parseDate(frontmatter.date, fallbackDate);
const updatedDate = frontmatter.updated
  ? parseDate(frontmatter.updated, publishDate)
  : undefined;

const postPath = "/admiration/";
const permalink = import.meta.env.SITE
  ? new URL(postPath, import.meta.env.SITE).toString()
  : postPath;

const siteConfig = themeConfig.sidebar || {};
const author = siteConfig.author || "Author";
const siteName = themeConfig.siteName || "Site";
---

<Layout pageTitle={title}>
  <Fragment slot="head">
    <meta name="description" content={description} />
  </Fragment>

  <div class="article wrap">
    <Breadcrumb isHome={false} />

    <article
      itemscope
      itemtype="http://schema.org/Article"
      class="post block"
      data-pagefind-body
      lang={currentLocale}
    >
      <link itemprop="mainEntityOfPage" href={permalink} />

      <PostHeader title={title} date={publishDate} />

      <div class="body md" itemprop="articleBody">
        <AdmirationContent />
      </div>

      <PostFooter
        date={publishDate}
        updated={updatedDate}
        permalink={permalink}
        title={title}
        author={author}
        siteName={siteName}
        showCopyright={true}
        showReward={false}
      />
    </article>
  </div>

  <div id="comments" class="comment">
    {/* Hyacine Plugin Outlet: Waline 评论 */}
    <HyacineOutlet name="comment" />
  </div>
</Layout>
